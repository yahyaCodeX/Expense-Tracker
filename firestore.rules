rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidDate(dateStr) {
      return dateStr is string && dateStr.size() == 10 && dateStr.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['date', 'breakfast', 'lunch', 'dinner', 'dailyTotal']) &&
             data.date is string &&
             data.breakfast is number && data.breakfast >= 0 && data.breakfast <= 50000 &&
             data.lunch is number && data.lunch >= 0 && data.lunch <= 50000 &&
             data.dinner is number && data.dinner >= 0 && data.dinner <= 50000 &&
             data.dailyTotal is number && data.dailyTotal >= 0 && data.dailyTotal <= 150000;
    }

    // User document and all its nested subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Matches any subcollection under /users/{userId} (expenses, messes, daily_expenses, pocket_money, etc.)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
